# Copy to `.env.local` and fill in secrets (never commit `.env.local`).

JWT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard login (standalone — not Shopify, not shopper Supabase login)
ADMIN_ACCESS_EMAIL=daniellinus163@gmail.com
ADMIN_ACCESS_PASSWORD=

# Owner panel (/owner) uses OWNER_EMAIL when set; defaults to same Gmail as admin schema.
# OWNER_EMAIL=daniellinus163@gmail.com

# Background playlist: comma-separated direct MP3/OGG URLs (your files/CDN — not Shopify).
# NEXT_PUBLIC_MUSIC_PLAYLIST_URLS=https://example.com/track1.mp3,https://example.com/track2.mp3
