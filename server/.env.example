PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vibecode_store

# Required for email/password login and Google OAuth cookie sync (API will return 503 if missing).
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Same Supabase keys as web/.env.local (either naming works).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
